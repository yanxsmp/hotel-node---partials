<div class="container body-content">
    <h2>Novo cliente</h2>

    <% if (errors && errors.length > 0) { %>
        <div class="alert alert-danger">
            <ul>
                <% errors.forEach(function(erro) { %>
                    <li><%= erro.msg %></li>
                <% }) %>
            </ul>
        </div>
    <% } %>

    <form action="/adm/adm-cliente-novo" method="post" enctype="multipart/form-data">

        <%- include("../partials/form-cliente", { dados: dados }) -%>

    </form>

    <div>
        <a class="btn btn-primary btn-lg" href="/adm/adm-cliente" role="button">
            Voltar
        </a>
    </div>

    <hr />

    <%- include("../partials/footer-adm") -%>

</div>