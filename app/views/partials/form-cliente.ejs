<div class="form-group">
    <label for="cep" class="control-label col-md-2">CEP</label>
    <div class="col-md-10">
        <input
            class="form-control"
            type="text"
            name="cep"
            id="cep"
            value="<%= dados.cep || '' %>">
    </div>
</div>

<div class="form-group" style="display:flex; align-items:center; gap:10px;">
    <label for="ImagemPerfil" class="control-label col-md-2">Imagem Perfil</label>
    <div class="col-md-5">
        <input
            class="form-control"
            type="file"
            name="ImagemPerfil"
            id="ImagemPerfil">
    </div>

    <img
        id="img-preview"
        src="../imagem/img_login.png"
        style="max-width:80px; max-height:80px;"
        alt="Pré-visualização">
</div>

<div class="form-group">
    <label for="nomeUsuario" class="control-label col-md-2">Nome de Usuário</label>
    <div class="col-md-10">
        <input
            class="form-control"
            type="text"
            name="nomeUsuario"
            id="nomeUsuario"
            value="<%= dados.nomeUsuario || '' %>">
    </div>
</div>

<div class="form-group">
    <label for="email" class="control-label col-md-2">E-mail</label>
    <div class="col-md-10">
        <input
            class="form-control"
            type="email"
            name="email"
            id="email"
            value="<%= dados.email || '' %>">
    </div>
</div>

<div class="form-group">
    <label for="senha" class="control-label col-md-2">Senha</label>
    <div class="col-md-10">
        <input
            class="form-control"
            type="password"
            name="senha"
            id="senha">
    </div>
</div>

<div class="form-group">
    <label for="tipo" class="control-label col-md-2">Tipo Usuário</label>
    <div class="col-md-10">
        <select class="form-control" name="tipo" id="tipo">
            <option value="">Selecione...</option>
            <option value="1" <%= dados.tipo == "1" ? "selected" : "" %>>
                Comum
            </option>
            <option value="2" <%= dados.tipo == "2" ? "selected" : "" %>>
                Gerente
            </option>
        </select>
    </div>
</div>

<div class="form-group">
    <label for="status" class="control-label col-md-2">Status</label>
    <div class="col-md-10">
        <select class="form-control" name="status" id="status">
            <option value="">Selecione...</option>
            <option value="1" <%= dados.status == "1" ? "selected" : "" %>>
                Ativo
            </option>
            <option value="0" <%= dados.status == "0" ? "selected" : "" %>>
                Inativo
            </option>
        </select>
    </div>
</div>

<div class="form-group">
    <div class="col-md-offset-2 col-md-10">
        <input
            type="submit"
            value="Salvar"
            class="btn btn-success">
    </div>
</div>